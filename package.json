    "jsdom": "^25.0.1",
    "playwright": "^1.50.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
