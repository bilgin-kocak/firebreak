{
  "name": "webmcp-firebreak",
  "private": true,
  "version": "0.0.0",
  "description": "One agent. Four robots. One human-approved rescue boundary.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@babylonjs/core": "^9.23.0",
    "@babylonjs/havok": "^1.3.14",
    "lucide-react": "^0.468.0",
