        "content": "What Northstar City services can you help me with here?"
      }
    ],
    "expectedTool": "inspect_portal",
    "expectedArgumentsSubset": {
      "serviceId": "all"
    }
  },
  {
    "id": "inspect-parking-fields",
    "pageState": "portal_idle",
    "messages": [
