    }
  },
  {
    "id": "invoke-guided-permit-tool",
    "pageState": "guided_tool_registered",
    "messages": [
      {
        "role": "user",
        "content": "Use the new renew_permit_guided tool for a 12-month permit."
      }
    ],
    "expectedTool": "renew_permit_guided",
    "expectedArgumentsSubset": {
      "durationMonths": 12
    },
