  {
    "id": "stage-guided-permit-tool",
    "pageState": "adaptive_view_checks_passed",
    "messages": [
      {
        "role": "user",
        "content": "Make this reusable as renew_permit_guided. It should take a duration, use my current vehicle and contact, calculate the fee, save a draft, and stop for review."
      }
    ],
    "expectedTool": "stage_workflow_tool",
    "expectedArgumentsSubset": {
      "name": "renew_permit_guided",
      "parameters": [
        {
          "name": "durationMonths",
          "fieldId": "permitDurationMonths",
          "required": true
        }
      ],
      "stopAt": "review"
    },
    "expectedOutcome": {
      "status": "awaiting_approval",
      "requiresHumanApproval": true,
      "registered": false
    }
  },
  {
    "id": "list-saved-workflow-tools",
    "pageState": "guided_tool_registered",
    "messages": [
