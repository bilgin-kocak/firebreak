      "serviceId": "parking_permit_renewal",
      "preferences": {
        "textSize": "xlarge",
        "languageStyle": "plain",
        "navigationStyle": "one_field_per_step",
        "controlStyle": "large_cards",
        "showProgress": true
      },
      "requireHumanConfirmation": true
    }
  },
  {
    "id": "compile-compact-power-user-permit",
    "pageState": "portal_inspected",
    "messages": [
      {
        "role": "user",
        "content": "Give me a compact, grouped parking permit renewal view with standard wording and no progress stepper."
      }
    ],
    "expectedTool": "compile_task_view",
    "expectedArgumentsSubset": {
      "serviceId": "parking_permit_renewal",
      "preferences": {
        "textSize": "normal",
        "languageStyle": "standard",
        "navigationStyle": "grouped",
        "controlStyle": "compact",
        "showProgress": false
      },
      "requireHumanConfirmation": true
    }
  },
  {
    "id": "inspect-created-view",
