    "expectedTool": "inspect_task_view",
    "expectedArgumentsSubset": {}
  },
  {
    "id": "move-contact-field",
    "pageState": "adaptive_view_active",
    "messages": [
      {
        "role": "user",
        "content": "Move the contact email question before the permit duration question."
      }
    ],
    "expectedTool": "patch_task_view",
    "expectedArgumentsSubset": {
      "patches": [
        {
          "type": "move_field",
          "fieldId": "contactEmail",
          "beforeFieldId": "permitDurationMonths"
        }
      ]
    }
  },
  {
    "id": "inspect-before-changing-human-lock",
    "pageState": "adaptive_view_vehicle_locked",
    "messages": [
      {
        "role": "user",
        "content": "Refine the view, but first check what I locked so you preserve my choices."
      }
    ],
    "expectedTool": "inspect_task_view",
    "expectedArgumentsSubset": {},
    "expectedOutcome": {
      "lockedElementIdsIncludes": "field:vehicleId",
      "nextSafeAction": "patch_only_unlocked_targets"
    }
  },
  {
    "id": "reject-patch-to-human-lock",
    "pageState": "adaptive_view_vehicle_locked",
    "messages": [
      {
        "role": "user",
        "content": "Change the vehicle field even though I locked it."
      }
    ],
    "expectedTool": "patch_task_view",
    "expectedArgumentsSubset": {
      "patches": [
        {
          "type": "move_field",
          "fieldId": "vehicleId"
        }
      ]
    },
    "expectedOutcome": {
      "ok": false,
      "code": "LOCKED_BY_USER",
      "atomic": true
    }
  },
  {
